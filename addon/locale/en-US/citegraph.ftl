# Attribute form is mandatory: a bare value makes Fluent replace the section's
# (respectively the sidenav button's) DOM/text with the string — the pane
# renders as a 25px "Citations" sliver and the icon shows clipped label text.
citegraph-pane-header =
    .label = Citations
citegraph-pane-sidenav =
    .tooltiptext = Citations

# MenuManager reads this from the window bundle via l10nID; needs .label
citegraph-menu-show =
    .label = Show Citation Graph
